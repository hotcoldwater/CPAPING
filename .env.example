# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env && chmod 600 .env

# --- 메일 발송 (Resend) ---
# 구독자에게 나가는 메일은 모두 Resend 로 보냅니다. Gmail SMTP 로 보내면
# 발신자에 운영자 개인 주소가 찍혀 모든 구독자에게 노출됩니다.
# 키 발급: resend.com > API Keys
RESEND_API_KEY=re_...
MAIL_FROM=CPAPING <noreply@cpaping.com>

# 관리자 알림을 받을 주소
CPAPING_MAIL_TO=ohshsh00@gmail.com

# --- 관리자 장애 알림 예비 경로 (Gmail SMTP) ---
# Resend 자체가 죽으면 그 사실을 알릴 길이 없어지므로 남겨 둡니다.
# 이 경로에는 구독자 정보가 실리지 않습니다.
# 앱 비밀번호 발급: https://myaccount.google.com/apppasswords
CPAPING_SMTP_USER=your-address@gmail.com
CPAPING_SMTP_APP_PASSWORD=abcd efgh ijkl mnop

# --- Supabase ---
# 대시보드 상단 [Connect] 버튼 또는 Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# secret key (sb_secret_...) — 구 service_role key.
# RLS를 우회하므로 크롤러(서버)에서만 사용. 절대 프론트엔드/깃에 노출 금지.
SUPABASE_SECRET_KEY=sb_secret_...

# --- 웹 (Phase 2~) ---
# publishable key (sb_publishable_...) — 구 anon key. RLS가 적용되며 공개해도 안전.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- 죽은 사람 스위치 (선택) ---
# 크롤이 끝날 때마다 이 주소로 신호를 보냅니다. 신호가 끊기면 감시 서비스가
# 대신 알려 줍니다. 지금까지의 장애 알림은 전부 "크롤러가 돌았을 때만" 나가서,
# 트리거 Worker 가 죽어 크롤 자체가 안 뜨는 경우를 잡지 못했습니다.
# healthchecks.io 에서 무료로 만들 수 있고, 비워 두면 아무 일도 하지 않습니다.
# 주기는 10분, grace 는 30분 정도로 두면 됩니다.
#
# **로컬 .env 에는 넣지 마세요.** 손으로 크롤러를 한 번 돌리면 OK 핑이 나가고,
# 그러면 운영 크롤이 멈춰 있어도 타이머가 되살아나 경보가 울리지 않습니다.
# GitHub Secrets 에만 넣습니다.
# HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Healthchecks: 기본값 false. 일시 실패는 성공 핑 중단으로 처리해 grace 적용.
# 대시보드 권장 Period 10분 + Grace 5분 (마지막 성공 이후 15분).
HEALTHCHECK_FAIL_FAST=false

# Gmail connection beta (no AI jobs or application sends).
CAREER_ENABLED=false
CAREER_MAIL_ONLY=false
CAREER_SEND_ENABLED=false
CAREER_ORIGIN=https://cpaping.com
MAIL_TOKEN_KEY=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# 지원현황·자소서 저장. AI/자동지원 작업은 검증 후 별도 활성화.
CAREER_HISTORY_ENABLED=true
CAREER_JOBS_ENABLED=false
CAREER_APPLICATIONS_ENABLED=false
